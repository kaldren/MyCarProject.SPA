@using AutoMapper;
@using MyCarProject.SPA.Interfaces;
@using MyCarProject.SPA.Models;

@inject IOnebrbApiClientPublic OnebrbApiClient
@inject IMapper Mapper

<div class="Components__Contact">
    @if (_isLoading)
    {
        <p>Loading...</p>
    }

    @if (_vehicleOwnerModel != default)
    {
        <RadzenCard class="m-3">
            <div class="d-flex flex-row p-3">
                <div>
                    <RadzenText TextStyle="TextStyle.Overline" class="d-flex mt-1 mb-0">Name</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@_vehicleOwnerModel.DisplayName</b></RadzenText>
                </div>
            </div>
            <RadzenCard class="my-3 rz-background-color-primary-lighter rz-shadow-0 rz-border-radius-0" style="margin: 0 calc(-1 * var(--rz-card-padding)); padding: 2rem;">
                <RadzenText TextStyle="TextStyle.H6" class="rz-color-primary-light"><strong>Contact Information</strong></RadzenText>
                <div class="row">
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-color-primary-light d-flex mt-3 mb-0">Phone</RadzenText>
                    <RadzenText TextStyle="TextStyle.Body1"><b>@_vehicleOwnerModel.Phone</b></RadzenText>
                </div>
            </RadzenCard>
        </RadzenCard>
    }
</div>

@code {
    [Parameter]
    public long VehicleId { get; set; }

    private VehicleOwnerModel _vehicleOwnerModel;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var api = await OnebrbApiClient.ApiVehiclesOwnerAsync(VehicleId);
            _vehicleOwnerModel = Mapper.Map<VehicleOwnerModel>(api.Result);
        }
        finally
        {
            _isLoading = false;
        }
    }
}