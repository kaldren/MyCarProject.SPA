@using AutoMapper;
@using Microsoft.AspNetCore.Authorization;
@using MyCarProject.SPA.Interfaces;
@using MyCarProject.SPA.Models;
@using OnebrbApi;

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOnebrbApiClientPublic OnebrbApiClient
@inject IMapper Mapper

<div class="Components__VehicleData">

    @if (_isLoading)
    {
        <p>Loading...</p>
    }

    @if (_vehicleModel != default)
    {
        <table class="table">
            <tbody>
                <tr>
                    <td>Brand</td>
                    <td>@_vehicleModel.Brand</td>
                </tr>
                <tr>
                    <td>Model</td>
                    <td>@_vehicleModel.Model</td>
                </tr>
                <tr>
                    <td>Year</td>
                    <td>@_vehicleModel.Year</td>
                </tr>
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter]
    public long VehicleId { get; set; }

    private VehicleModel _vehicleModel;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var api = await OnebrbApiClient.ApiVehiclesAsync(VehicleId);
            _vehicleModel = Mapper.Map<VehicleModel>(api.Result);
        }
        finally
        {
            _isLoading = false;
        }
    }
}