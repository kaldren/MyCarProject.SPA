@code {
    [Parameter]
    public long VehicleId { get; set; }

    private VehicleModel _vehicleModel;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var api = await OnebrbApiClient.ApiVehiclesAsync(VehicleId);
            _vehicleModel = Mapper.Map<VehicleModel>(api.Result);
        }
        finally
        {
            _isLoading = false;
        }
    }
}