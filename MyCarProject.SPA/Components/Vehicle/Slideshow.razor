@using AutoMapper;
@using MyCarProject.SPA.Interfaces;
@using MyCarProject.SPA.Models;

@inject IOnebrbApiClientPublic OnebrbApiClient
@inject IMapper Mapper
@inject IStringLocalizer<Localization.SharedResource> LocalizerShared

<div class="Components__Slideshow">

    @if (_isLoading)
    {
        <p>@LocalizerShared["Loading"]</p>
    }

    @if (_vehicleImageModel != default)
    {
        <Carousel ImageUrls="_vehicleImageModel.Select(p => p.ImageUrl).ToList()" />
    }
</div>

@code {
    [Parameter]
    public long VehicleId { get; set; }

    private List<VehicleImageModel> _vehicleImageModel;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var api = await OnebrbApiClient.ApiVehiclesImagesAsync(VehicleId);
            _vehicleImageModel = Mapper.Map<List<VehicleImageModel>>(api.Result);
        }
        finally
        {
            _isLoading = false;
        }
    }
}