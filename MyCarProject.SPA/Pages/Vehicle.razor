@page "/vehicles/{Id:long}"

@using MyCarProject.SPA.Components.Vehicle

<div class="Pages__Vehicle">
    <main>
        <Slideshow VehicleId="@Id" />
        <VehicleData VehicleId="@Id" />
        <Comment VehicleId="@Id" />
    </main>
    <aside>
        <Contact VehicleId="@Id" />
    </aside>
</div>

@code {
    [Parameter]
    public long Id { get; set; }
}