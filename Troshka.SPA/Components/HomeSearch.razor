@using AutoMapper;
@using Troshka.SPA.Interfaces;
@using Troshka.SPA.Models;
@using Sve.Blazor.InfiniteScroll.Components
@using Troshka.SPA.Models.Car;

@inject IOnebrbApiClientPublic OnebrbApiClient
@inject IMapper Mapper
@inject IStringLocalizer<Localization.SharedResource> LocalizerShared

<div class="Components__HomeSearch">
    @if (_isLoading)
    {
        <p>@LocalizerShared["Loading"]</p>
    }
    else
    {
        <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerShared["Category"] Data=@_categories TextProperty="Name" ValueProperty="Name" @bind-Value=@_carSearch.Category Change=@(args => OnChange(args)) />

        <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerShared["Brand"] Data=@_brandList TextProperty="BrandName" ValueProperty="BrandId" @bind-Value=@_carSearch.BrandId />

        <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerShared["Model"] Data=@_modelList TextProperty="ModelName" ValueProperty="ModelId" @bind-Value=@_carSearch.ModelId />

        <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerShared["Year"] Data=@_yearList TextProperty="YearName" ValueProperty="YearId" Change=@(args => OnChange(args)) />

        <RadzenButton Click=@(args => OnSearchButtonClick()) Icon="search" ButtonStyle="ButtonStyle.Primary" />
    }
</div>

@if (_showSearchResults == true)
{
    <SearchResultInfiniteScroll Data=@_carSearch />
}

@code {
    private ICollection<CategoryModel> _categories;
    private IEnumerable<Brand> _brandList;
    private IEnumerable<Model> _modelList;
    private IEnumerable<Year> _yearList;
    private CarSearchRequestModel _carSearch = new();

    private bool _isLoading;
    private bool _showSearchResults;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var api = await OnebrbApiClient.ApiVehiclesCategoriesAsync();
            _categories = Mapper.Map<List<CategoryModel>>(api.Result);
        }
        finally
        {
            _isLoading = false;
        }

        _brandList = new List<Brand>
        {
            new Brand {BrandId = "48xSUCHrRIfABkLmGHxD", BrandName = "Audi"},
            new Brand {BrandId = "dasdsada", BrandName = "BMW"},
            new Brand {BrandId = "dasdsada", BrandName = "Mercedes"},
            new Brand {BrandId = "dasdsada", BrandName = "VW"},
        };

        _modelList = new List<Model>
        {
            new Model {ModelId = "CHMcpA79gbWpMI1fQVQ8", ModelName = "A6"},
            new Model {ModelId = "dasdsaa", ModelName = "A8"},
            new Model {ModelId = "dasdsaa", ModelName = "A4"},
            new Model {ModelId = "dasdsaa", ModelName = "Q8"},
        };

        _yearList = new List<Year>
        {
            new Year {YearId = 1, YearName = "2023"},
            new Year {YearId = 2, YearName = "2022"},
            new Year {YearId = 3, YearName = "2021"},
            new Year {YearId = 4, YearName = "2020"},
        };
    }

    void OnChange(object value)
    {
        var str = value is IEnumerable<object> ? string.Join(", ", (IEnumerable<object>)value) : value;
    }

    void OnSearchButtonClick()
    {
        _showSearchResults = true;
    }

    class Vehicle
    {
        public int VehicleId { get; set; }

        public string VehicleType { get; set; }
    }

    class Brand
    {
        public string BrandId { get; set; }

        public string BrandName { get; set; }
    }

    class Model
    {
        public string ModelId { get; set; }

        public string ModelName { get; set; }
    }

    class Year
    {
        public int YearId { get; set; }

        public string YearName { get; set; }
    }
}