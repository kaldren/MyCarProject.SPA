    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var api = await OnebrbApiClient.ApiVehiclesCategoriesAsync();
            _categories = Mapper.Map<List<CategoryModel>>(api.Result);
        }
        finally
        {
            _isLoading = false;
        }

        _brandList = new List<Brand>
        {
            new Brand {BrandId = "48xSUCHrRIfABkLmGHxD", BrandName = "Audi"},
            new Brand {BrandId = "dasdsada", BrandName = "BMW"},
            new Brand {BrandId = "dasdsada", BrandName = "Mercedes"},
            new Brand {BrandId = "dasdsada", BrandName = "VW"},
        };

        _modelList = new List<Model>
        {
            new Model {ModelId = "CHMcpA79gbWpMI1fQVQ8", ModelName = "A6"},
            new Model {ModelId = "dasdsaa", ModelName = "A8"},
            new Model {ModelId = "dasdsaa", ModelName = "A4"},
            new Model {ModelId = "dasdsaa", ModelName = "Q8"},
