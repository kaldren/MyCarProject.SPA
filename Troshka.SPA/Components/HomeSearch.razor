    }

    void OnChange(object value)
    {
        var str = value is IEnumerable<object> ? string.Join(", ", (IEnumerable<object>)value) : value;
    }

    void OnSearchButtonClick()
    {
        _showSearchResults = true;
    }

    async Task ShowFiltersDialog()
    {
        await DialogService.OpenAsync("Filters", ds =>

        @<SearchCheckboxFilters SearchFilters=SearchFilters />, 
        new DialogOptions() { CloseDialogOnOverlayClick = true, CssClass="Dialog__SearchCheckBoxFilters" });
    }

    class Vehicle
    {
        public int VehicleId { get; set; }

        public string VehicleType { get; set; }
    }

    class Brand
    {
        public string BrandId { get; set; }

        public string BrandName { get; set; }
    }

    class Model
    {
        public string ModelId { get; set; }

        public string ModelName { get; set; }
    }

    class Year
    {
        public int YearId { get; set; }

        public string YearName { get; set; }
    }

    public void Dispose()
    {
        DialogService.OnOpen -= Open;
        DialogService.OnClose -= Close;
    }

    void Open(string title, Type type, Dictionary<string, object> parameters, DialogOptions options)
    {
    }

    void Close(dynamic result)
    {
    }
}