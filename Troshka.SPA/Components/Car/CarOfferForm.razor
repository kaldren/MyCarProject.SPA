@using AutoMapper;
@using Troshka.SPA.Components.Vehicle
@using Troshka.SPA.Interfaces;
@using Troshka.SPA.Models.Car;
@using Troshka.SPA.Models;
@using Troshka.SPA.Models.Common;
@using static Troshka.SPA.Components.VehicleSearch;

@inject IStringLocalizer<Localization.SharedResource> LocalizerShared
@inject IStringLocalizer<Localization.OfferResource> LocalizerOffer
@inject DialogService DialogService
@inject ITroshkaApiClientPublic TroshkaApiClient
@inject IMapper Mapper

<div class="Components__CarOfferForm">
    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerOffer["Specification_Category"] Data=@_categoriesList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.CategoryId Change=@(args => OnVehicleBrandChange()) />

    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerShared["Brand"] Data=@_brandList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.BrandId Change=@(args => OnVehicleBrandChange()) />

    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerShared["Model"] Data=@_modelList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.ModelId />

    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerOffer["Specification_Engine"] Data=@_enginesList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.EngineId Change=@(args => OnChange(args)) />

    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerOffer["Specification_Transmission"] Data=@_transmissionList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.TransmissionId Change=@(args => OnChange(args)) />

    <RadzenNumeric Placeholder="Horsepower" @bind-Value=_carModel.Horsepower class="w-100" />
    <RadzenNumeric Placeholder="Mileage" @bind-Value=_carModel.Mileage class="w-100" />

 @*   <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerShared["Year"] Data=@_yearList TextProperty="YearName" ValueProperty="YearId" @bind-Value=@_carModel.Year Change=@(args => OnChange(args)) />
*@
    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerOffer["Specification_Euro"] Data=@_euroStandardList TextProperty="EuroStandard" ValueProperty="EuroStandardId" @bind-Value=@_carModel.EuroStandard Change=@(args => OnChange(args)) />

    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerOffer["Specification_Euro"] Data=@_euroStandardList TextProperty="EuroStandard" ValueProperty="EuroStandardId" @bind-Value=@_carModel.EuroStandard Change=@(args => OnChange(args)) />


    <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                    Placeholder=@LocalizerOffer["Specification_Euro"] Data=@_euroStandardList TextProperty="EuroStandard" ValueProperty="EuroStandardId" @bind-Value=@_carModel.EuroStandard Change=@(args => OnChange(args)) />

    <RadzenDatePicker @bind-Value=@dateProduced DateFormat="yyyy/MM" Max="DateTime.Now">
        <FooterTemplate>
            <RadzenButton Click=@(args => dateProduced = DateTime.Now) Text="Today" class="my-3 w-100" />
        </FooterTemplate>
    </RadzenDatePicker>

    <RadzenRadioButtonList @bind-Value=@value TValue="int" class="mb-5">
        <Items>
            <RadzenRadioButtonListItem Text="New" Value="1" />
            <RadzenRadioButtonListItem Text="Used" Value="2" />
            <RadzenRadioButtonListItem Text="For Parts" Value="3" />
        </Items>
    </RadzenRadioButtonList>

    <RadzenButton Text=@LocalizerOffer["Filters"] ButtonStyle="ButtonStyle.Secondary" Click=@ShowFiltersDialog />

</div>

@code {
    private CreateCarOfferRequestModel _offer;
    private IEnumerable<CarCategoryModel> _categoriesList;
    private IEnumerable<VehicleBrandModel> _brandList;
    private IEnumerable<VehicleModelModel> _modelList;
    private IEnumerable<EuroStandardModel> _euroStandardList;
    private IEnumerable<CommonRegionModel> _regionList;
    private IEnumerable<CommonLocationModel> _locationList;
    private IEnumerable<VehicleEngineModel> _enginesList;
    private IEnumerable<VehicleTransmissionModel> _transmissionList;
    private List<int> _yearList;
    private ICollection<VehicleCategoryModel> _categories;
    private Filters SearchFilters = new();
    private CreateCarOfferRequestModel _carModel = new();
    RadzenUpload upload;

