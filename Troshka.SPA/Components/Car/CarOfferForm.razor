@using AutoMapper;
@using Microsoft.AspNetCore.Authorization;
@using Troshka.SPA.Components.Vehicle
@using Troshka.SPA.Interfaces;
@using Troshka.SPA.Models.Car;
@using Troshka.SPA.Models;
@using Troshka.SPA.Models.Common;
@using TroshkaApi;
@using static Troshka.SPA.Components.VehicleSearch;
@*@attribute [Authorize]*@

@inject IStringLocalizer<Localization.SharedResource> LocalizerShared
@inject IStringLocalizer<Localization.OfferResource> LocalizerOffer
@inject DialogService DialogService
@inject ITroshkaApiClientPublic TroshkaApiClientPublic
@inject ITroshkaApiClient TroshkaApiClientPrivate
@inject IMapper Mapper

<div class="Components__CarOfferForm">
    <h2>Create new offer</h2>

    <div class="Components__CarOfferForm--row">
        <div>
            <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Specification_Category"] Data=@_categoriesList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.CategoryId Change=@(args => OnVehicleBrandChange()) />

            <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerShared["Brand"] Data=@_brandList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.BrandId Change=@(args => OnVehicleBrandChange()) />

            <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerShared["Model"] Data=@_modelList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.ModelId />
        </div>
    </div>

    <div class="Components__CarOfferForm--row">
        <div>
            <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Specification_Engine"] Data=@_enginesList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.EngineId Change=@(args => OnChange(args)) />

            <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Specification_Transmission"] Data=@_transmissionList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.TransmissionId Change=@(args => OnChange(args)) />

               <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
            Placeholder=@LocalizerShared["Year"] Data=@_yearList @bind-Value=@_carModel.Year />
            
            <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Region"] Data=@_euroStandardList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.RegionId Change=@(args => OnChange(args)) />

            <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Location"] Data=@_euroStandardList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.LocationId Change=@(args => OnChange(args)) />
        </div>
    </div>

    <div class="Components__CarOfferForm--row">
        <div>
            <div>
                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                                Placeholder=@LocalizerOffer["Specification_Euro"] Data=@_euroStandardList TextProperty="Name" ValueProperty="Id" @bind-Value=@_carModel.EuroStandardId Change=@(args => OnChange(args)) />
            </div>
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Horsepower</RadzenText>
                <RadzenNumeric Placeholder="Horsepower" @bind-Value=_carModel.Horsepower class="w-100" />
            </div>
            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Mileage</RadzenText>
                <RadzenNumeric Placeholder="Mileage" @bind-Value=_carModel.Mileage class="w-100" />
            </div>

            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Cubics</RadzenText>
                <RadzenNumeric Placeholder="Cubics" @bind-Value=_carModel.Cubics class="w-100" />
            </div>

            <div>
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">Production date</RadzenText>
                <RadzenDatePicker @bind-Value=@dateProduced DateFormat="yyyy/MM" Max="DateTime.Now">
                    <FooterTemplate>
                        <RadzenButton Click=@(args => dateProduced = DateTime.Now) Text="Today" class="my-3 w-100" />
                    </FooterTemplate>
                </RadzenDatePicker>
            </div>

            <RadzenRadioButtonList @bind-Value=@value TValue="int" class="mb-5">
                <Items>
                    <RadzenRadioButtonListItem Text="New" Value="1" />
                    <RadzenRadioButtonListItem Text="Used" Value="2" />
                    <RadzenRadioButtonListItem Text="For Parts" Value="3" />
                </Items>
            </RadzenRadioButtonList>
        </div>
    </div>

    <div class="Components__CarOfferForm--row">
        <div>
            <RadzenTextArea Placeholder="Description..." Change=@(args => OnChange(args)) class="w-100" />
        </div>
        <div>
            <RadzenButton Text=@LocalizerOffer["Filters"] ButtonStyle="ButtonStyle.Secondary" Click=@ShowFiltersDialog class="filter-btn" />
        </div>
        <RadzenButton Click=@(args => OnPostButtonClick()) Disabled=@_postBtnDisabled Icon="done" ButtonStyle="ButtonStyle.Primary" class="post-button" />
    </div>
</div>

@code {
    private IEnumerable<CarCategoryModel> _categoriesList;
    private IEnumerable<VehicleBrandModel> _brandList;
    private IEnumerable<VehicleModelModel> _modelList;
    private IEnumerable<EuroStandardModel> _euroStandardList;
    private IEnumerable<CommonRegionModel> _regionList;
    private IEnumerable<CommonLocationModel> _locationList;
    private IEnumerable<VehicleEngineModel> _enginesList;
    private IEnumerable<VehicleTransmissionModel> _transmissionList;
    private List<string> _yearList;
    private ICollection<VehicleCategoryModel> _categories;
    private Models.Car.CreateCarOfferRequestModel _carModel = new();
    RadzenUpload upload;

    int value = 1;
    int registered = 1;
    DateTime? dateProduced = DateTime.Now;
    private bool _postBtnDisabled;

    protected override async Task OnInitializedAsync()
    {
        var categories = await TroshkaApiClientPublic.ApiCarsCategoriesAsync();
        _categoriesList = Mapper.Map<ICollection<CarCategoryModel>>(categories.Result);

        var response = await TroshkaApiClientPublic.ApiCarsBrandsAsync();
        _brandList = Mapper.Map<ICollection<VehicleBrandModel>>(response.Result);

        var engine = await TroshkaApiClientPublic.ApiCarsEnginesAsync();
        _enginesList = Mapper.Map<ICollection<VehicleEngineModel>>(engine.Result);

        var transmission = await TroshkaApiClientPublic.ApiCarsTransmissionsAsync();
        _transmissionList = Mapper.Map<ICollection<VehicleTransmissionModel>>(transmission.Result);

        var euro = await TroshkaApiClientPublic.ApiCarsEuroAsync();
        _euroStandardList = Mapper.Map<ICollection<EuroStandardModel>>(euro.Result);

        _yearList = new List<string>();
        for (int i = 0; i < 100; i++)
        {
            _yearList.Add((DateTime.Now.Year - i).ToString());
        }
    }

    async Task ShowFiltersDialog()
    {
        await DialogService.OpenAsync(@LocalizerOffer["Filters"], ds =>

    @<SearchCheckboxFilters SearchFilters=_carModel.Filters />,
        new DialogOptions() { CloseDialogOnOverlayClick = true, CssClass = "Dialog__SearchCheckBoxFilters" });
    }

    private void OnSubmit(string text)
    {
        TroshkaApiClientPrivate.ApiCarsOffersPostAsync(Mapper.Map<TroshkaApi.CreateCarOfferRequestModel>(_carModel));
    }

    async Task OnVehicleBrandChange()
    {
        if (!string.IsNullOrWhiteSpace(_carModel.BrandId))
        {
            var response = await TroshkaApiClientPublic.ApiCarsBrandsModelsAsync(_carModel.BrandId);
            _modelList = Mapper.Map<ICollection<VehicleModelModel>>(response.Result);
        }
        else
        {
            _modelList = null;
        }
    }

    void OnPostButtonClick()
    {
        TroshkaApiClientPrivate.ApiCarsOffersPostAsync(Mapper.Map<TroshkaApi.CreateCarOfferRequestModel>(_carModel));
    }

    void OnChange(object value)
    {
        //var str = value is IEnumerable<object> ? string.Join(", ", (IEnumerable<object>)value) : value;
    }

    void OnChange(string value)
    {
    }

    void OnChange(UploadChangeEventArgs args, string name)
    {
        foreach (var file in args.Files)
        {
            //console.Log($"File: {file.Name} / {file.Size} bytes");
        }

        //console.Log($"{name} changed");
    }

    void OnProgress(UploadProgressArgs args, string name)
    {
        //console.Log($"{args.Progress}% '{name}' / {args.Loaded} of {args.Total} bytes.");

        if (args.Progress == 100)
        {
            foreach (var file in args.Files)
            {
                //console.Log($"Uploaded: {file.Name} / {file.Size} bytes");
            }
        }
    }
}
