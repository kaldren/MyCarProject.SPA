@code {
    [Parameter]
    public string Id { get; set; }

    private CarOfferModel _carOfferModel;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var api = await OnebrbApiClient.ApiOffersCarsAsync(Id);
            _carOfferModel = Mapper.Map<CarOfferModel>(api.Result);
        }
        finally
        {
            _isLoading = false;
        }
    }
}