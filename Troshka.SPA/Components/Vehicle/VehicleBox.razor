@using Troshka.SPA.Models.Car;

<div class="Components__VehicleBox">
    <div class="flex items-center justify-center">
            <div class="max-w-md md:max-w-2xl px-2">
                <div class="bg-white shadow-xl rounded-lg overflow-hidden">
                    <div>
                        <img src="/img/carmock.jpg" class="Components__VehicleBox--car-photo" alt="@Model.Title" />
                        <div class="p-4 md:p-5">
                            <p class="font-bold text-xl md:text-2xl">@Model.Title</p>
                            <p class="text-gray-700 md:text-lg">@Model.Description</p>
                        </div>
                        <div class="p-4 md:p-5 bg-gray-100">
                            <div class="sm:flex sm:justify-between sm:items-center">
                                <div>
                                    <div class="text-lg text-gray-700"><span class="text-gray-900 font-bold">@Model.Price</span> BGN</div>
                                    <div class="flex items-center">
                                        <div class="flex inline-flex -mx-px">
                                            <svg class="w-4 h-4 mx-px fill-current text-green-600" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14">
                                                <path d="M6.43 12l-2.36 1.64a1 1 0 0 1-1.53-1.11l.83-2.75a1 1 0 0 0-.35-1.09L.73 6.96a1 1 0 0 1 .59-1.8l2.87-.06a1 1 0 0 0 .92-.67l.95-2.71a1 1 0 0 1 1.88 0l.95 2.71c.13.4.5.66.92.67l2.87.06a1 1 0 0 1 .59 1.8l-2.3 1.73a1 1 0 0 0-.34 1.09l.83 2.75a1 1 0 0 1-1.53 1.1L7.57 12a1 1 0 0 0-1.14 0z" />
                                            </svg>
