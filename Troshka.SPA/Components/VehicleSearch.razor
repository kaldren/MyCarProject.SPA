    private VehicleSearchRequestModel _offerSearch = new();
    private VehicleSearchRequestModel _prevOfferSearch;

    private List<CarOfferModel> _carOffers = new();

    private const int MaxOffersPerFetch = 10;
    private int _totalFetched = 0;
    private bool _isLoading;
    private bool _showNoResults;
    private bool _searchBtnClicked;
    private bool _searchBtnDisabled;
    private bool _hasAppendedFilter = false;
    private bool _shouldRender = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;
            var hasLocalCategories = await LocalStorage.GetItemAsync<List<VehicleCategoryModel>>(LocalStorageConstants.Troshka_VehicleSearch_Categories);
            var hasLocalRegions = await LocalStorage.GetItemAsync<List<CommonRegionModel>>(LocalStorageConstants.Troshka_VehicleSearch_Categories);

            if (hasLocalCategories == null)
            {
                var api = await TroshkaApiClient.ApiCommonCategoriesAsync();
                _categories = Mapper.Map<List<VehicleCategoryModel>>(api.Result);
                _offerSearch.Category = _categories.SingleOrDefault(p => p.Name == "Cars").Name;
                await OnVehicleCategoryChange();
                await LocalStorage.SetItemAsync(LocalStorageConstants.Troshka_VehicleSearch_Categories, _categories);
            }
            else
            {
                _categories = await LocalStorage.GetItemAsync<List<VehicleCategoryModel>>(LocalStorageConstants.Troshka_VehicleSearch_Categories);
                _offerSearch.Category = _categories.SingleOrDefault(p => p.Name == "Cars").Name;
            }

            if (hasLocalRegions == null)
            {
                var regionsApi = await TroshkaApiClient.ApiCommonRegionsAsync();
                _regionList = Mapper.Map<List<CommonRegionModel>>(regionsApi.Result);
                await LocalStorage.SetItemAsync(LocalStorageConstants.Troshka_VehicleSearch_Regions, _regionList);
            }
            else
            {
                _regionList = await LocalStorage.GetItemAsync<List<CommonRegionModel>>(LocalStorageConstants.Troshka_VehicleSearch_Regions);
            }

        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override bool ShouldRender()
    {
        return _shouldRender;
    }

    private async Task FetchOffers()
    {
        // New search
        if (_searchBtnClicked)
        {
            _carOffers.Clear();
            _totalFetched = 0;
            _hasAppendedFilter = false;
        }

        var client = HttpClientFactory.CreateClient("TroshkaAPINoAuth");
        bool _hasFilters = HasFilters(_offerSearch);

        if (string.IsNullOrWhiteSpace(_offerSearch.Category) && !_hasFilters)
            return;

        if (!string.IsNullOrWhiteSpace(_offerSearch.Category) && _offerSearch.Category == "Cars")
        {
            _hasAppendedFilter = false;
            StringBuilder uriBuilder = new("/api/cars/offers");

            if (_hasFilters)
            {
                uriBuilder.Append("?$filter=");

                if (_offerSearch.BrandId != null)
                {
                    string and = _hasAppendedFilter ? " and " : string.Empty;

                    uriBuilder.Append($"{and}Specification / {nameof(_offerSearch.BrandId)} eq '{_offerSearch.BrandId}'");

                    _hasAppendedFilter = true;
                }

                if (_offerSearch.ModelId != null)
                {
                    string and = _hasAppendedFilter ? "and" : string.Empty;

                    uriBuilder.Append($"{and}Specification / {nameof(_offerSearch.ModelId)} eq '{_offerSearch.ModelId}'");

                    _hasAppendedFilter = true;
                }

                if (_offerSearch.EngineId != null)
                {
                    string and = _hasAppendedFilter ? "and" : string.Empty;

                    uriBuilder.Append($"{and}Specification / {nameof(_offerSearch.EngineId)} eq '{_offerSearch.EngineId}'");

                    _hasAppendedFilter = true;
                }

                if (_offerSearch.TransmissionId != null)
                {
                    string and = _hasAppendedFilter ? "and" : string.Empty;

                    uriBuilder.Append($"{and}Specification / {nameof(_offerSearch.TransmissionId)} eq '{_offerSearch.TransmissionId}'");

                    _hasAppendedFilter = true;
                }

                if (_offerSearch.RegionId != null)
                {
                    string and = _hasAppendedFilter ? " and " : string.Empty;

                    uriBuilder.Append($"{and}Region / Id eq '{_offerSearch.RegionId}'");

                    _hasAppendedFilter = true;
                }

                if (_offerSearch.LocationId != null)
                {
                    string and = _hasAppendedFilter ? " and " : string.Empty;

                    uriBuilder.Append($"{and}Location / Id eq '{_offerSearch.LocationId}'");

                    _hasAppendedFilter = true;
                }

                IterateCheckboxFilters(uriBuilder);
            }

            if (!_hasFilters)
            {
                uriBuilder.Append($"?&top={MaxOffersPerFetch}&$skip={_totalFetched}");
            }
            else
            {
                uriBuilder.Append($"&$top={MaxOffersPerFetch}&$skip={_totalFetched}");
            }

            var response = await client.GetAsync($"{uriBuilder.ToString()}");

            response.EnsureSuccessStatusCode();

            var apiResponse = await response.Content.ReadFromJsonAsync<IEnumerable<CarOfferModel>>();

            if (apiResponse.Any())
            {
                _carOffers.AddRange(apiResponse);

                _totalFetched += apiResponse.Count();
                _showNoResults = false;
            }
            else
            {
                if (_searchBtnClicked)
                {
                    // No results - show that to the user
                    _showNoResults = true;
                }
            }
        }

        if (_searchBtnClicked && _carOffers.Count == 0)
        {
            _showNoResults = true;
        }
        else
        {
            _showNoResults = false;
        }
    }

