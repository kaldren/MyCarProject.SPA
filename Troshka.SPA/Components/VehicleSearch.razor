    void OnChange(object value)
    {
        var str = value is IEnumerable<object> ? string.Join(", ", (IEnumerable<object>)value) : value;
    }

    async Task OnVehicleCategoryChange()
    {
        if (!string.IsNullOrWhiteSpace(_offerSearch.Category))
        {
            if (_offerSearch.Category == "Cars")
            {
                var response = await TroshkaApiClient.ApiCarsBrandsAsync();
                _brandList = Mapper.Map<ICollection<VehicleBrandModel>>(response.Result);

                var engine = await TroshkaApiClient.ApiCarsEnginesAsync();
                _enginesList = Mapper.Map<ICollection<VehicleEngineModel>>(engine.Result);

                var transmission = await TroshkaApiClient.ApiCarsTransmissionsAsync();
                _transmissionList = Mapper.Map<ICollection<VehicleTransmissionModel>>(transmission.Result);

                _searchBtnDisabled = false;
            }
            else
            {
                _brandList = null;
                _modelList = null;
                _enginesList = null;
                _transmissionList = null;
                _searchBtnDisabled = true;
            }
        }
    }

    async Task OnVehicleBrandChange()
    {
        if (!string.IsNullOrWhiteSpace(_offerSearch.BrandId))
        {
            if (_offerSearch.Category == "Cars")
            {
                var response = await TroshkaApiClient.ApiCarsBrandsModelsAsync(_offerSearch.BrandId);
                _modelList = Mapper.Map<ICollection<VehicleModelModel>>(response.Result);
            }
        }
        else
        {
            _modelList = null;
        }
    }

    async Task OnRegionChange()
    {
        if (_offerSearch.RegionId != null)
        {
            var response = await TroshkaApiClient.ApiCommonRegionsLocationsAsync(_offerSearch.RegionId);
            _locationList = Mapper.Map<ICollection<CommonLocationModel>>(response.Result);
        }
        else
        {
            _locationList = null;
        }
    }

    async Task OnSearchButtonClick()
    {
        _searchBtnClicked = true;
        _searchBtnDisabled = true;
        await FetchOffers();
        _searchBtnClicked = false;
        _searchBtnDisabled = false;
    }

