@implements IDisposable
<div class="Components__VehicleSearch">
    @if (_isLoading)
    {
        <p>@LocalizerShared["Loading"]</p>
    }
    else
    {
        <div class="main__search">
            <div class="main__search--categories">
                <RadzenDropDown TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerShared["Category"] Data=@_categories TextProperty="Name" ValueProperty="Name" @bind-Value=@_offerSearch.Category Change=@(args => OnVehicleCategoryChange()) />
            </div>

            <div class="main__search--main">
                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerShared["Brand"] Data=@_brandList TextProperty="Name" ValueProperty="Id" @bind-Value=@_offerSearch.BrandId Change=@(args => OnVehicleBrandChange()) />

                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerShared["Model"] Data=@_modelList TextProperty="Name" ValueProperty="Id" @bind-Value=@_offerSearch.ModelId />

                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Specification_Engine"] Data=@_enginesList TextProperty="Name" ValueProperty="Id" @bind-Value=@_offerSearch.EngineId Change=@(args => OnChange(args)) />

                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Specification_Transmission"] Data=@_transmissionList TextProperty="Name" ValueProperty="Id" @bind-Value=@_offerSearch.TransmissionId Change=@(args => OnChange(args)) />

                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerShared["Year"] Data=@_yearList TextProperty="YearName" ValueProperty="YearId" @bind-Value=@_offerSearch.Year Change=@(args => OnChange(args)) />
            </div>

            <div class="main__search--region">
                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Region"] Data=@_regionList TextProperty="Name" ValueProperty="Id" @bind-Value=@_offerSearch.RegionId Change=@(args => OnRegionChange()) />

                <RadzenDropDown AllowClear="true" TValue="string" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowFiltering="true" class="w-100"
                            Placeholder=@LocalizerOffer["Location"] Data=@_locationList TextProperty="Name" ValueProperty="Id" @bind-Value=@_offerSearch.LocationId Change=@(args => OnChange(args)) />
            </div>

        </div>
        <div class="search-filters">
            <RadzenButton Text=@LocalizerOffer["Filters"] ButtonStyle="ButtonStyle.Secondary" Click=@ShowFiltersDialog />
        </div>

        <div class="search-button">
            <RadzenButton Click=@(args => OnSearchButtonClick()) Disabled=@_searchBtnDisabled Icon="search" ButtonStyle="ButtonStyle.Primary" />
        </div>
    }
</div>
@if (_showNoResults)
{
    <div class="no-results-found">
        @LocalizerOffer["NoResultsFound"]
    </div>
}
@if (_carOffers.Count > 0)
{
    <div class="Components__SearchResultInfiniteScroll">
        <Sve.Blazor.InfiniteScroll.Components.InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReached="(e) => FetchOffers()">
            <ul>
                @foreach (var offer in _carOffers)
                {
                    string uri = $"offers/{offer.Id}";

                    <li>
                        <VehicleBox Model=@offer />
                    </li>
                }

                <li class="list-group-item" id="observerTarget"></li>
            </ul>
        </Sve.Blazor.InfiniteScroll.Components.InfiniteScroll>
    </div>
}


@code {
