@using AutoMapper;
@using System.Net;
@using System.Text.Json;
@using Troshka.SPA.Interfaces;
@using Troshka.SPA.Models.Car;

@inject IOnebrbApiClientPublic OnebrbApiClient
@inject IMapper Mapper
@inject IHttpClientFactory HttpClientFactory;
<div class="Components__SearchResultInfiniteScroll">
    @if (cars == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <Sve.Blazor.InfiniteScroll.Components.InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReached="(e) => FetchForecasts()">
            <ul>
                @foreach (var forecast in cars)
                {
                    <li class="list-group-item">@forecast.Title @forecast.Price @forecast.Description</li>
                }

                @*The target element that we observe. Once this is reached the callback will be triggered.*@
                <li class="list-group-item" id="observerTarget"></li>
            </ul>
        </Sve.Blazor.InfiniteScroll.Components.InfiniteScroll>
    }
</div>

@code {
    [Parameter]
    public CarSearchRequestModel Data { get; set; }

    private IEnumerable<CarOfferModel> cars;

    protected override async Task OnInitializedAsync()
    {
        await FetchForecasts(); // Initial data
    }

    private async Task FetchForecasts()
    {
        var client = HttpClientFactory.CreateClient("OnebrbAPINoAuth");
        //cars = await client.GetFromJsonAsync<IEnumerable<CarOfferModel>>($"/api/offers/cars?$filter=Specification/BrandId eq '{Data.BrandId}' and Specification/ModelId eq '{Data.ModelId}'");
        var response = await client.GetAsync($"/api/offers/cars?$filter=Specification/BrandId eq '{Data.BrandId}' and Specification/ModelId eq '{Data.ModelId}'");

        response.EnsureSuccessStatusCode();


        cars = await response.Content.ReadFromJsonAsync<IEnumerable<CarOfferModel>>();

        //var fetchedCars = await OnebrbApiClient.ApiOffersCarsGetAsync();
    }
}