@using AutoMapper;
@using System.Net;
@using System.Text.Json;
@using Troshka.SPA.Interfaces;
@using Troshka.SPA.Models.Car;

@inject IOnebrbApiClientPublic OnebrbApiClient
@inject IMapper Mapper
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager

<div class="Components__SearchResultInfiniteScroll">
    @if (_carOffers.Count == 0)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <Sve.Blazor.InfiniteScroll.Components.InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReached="(e) => FetchForecasts()">
            <ul>
                @foreach (var offer in _carOffers)
                {
                    string uri = $"offers/{offer.Id}";

                    <li>
                        <a href="@uri" target="_blank">
                            <RadzenCard>
                                <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center">
                                    <RadzenImage Path="/img/carmock.jpg" />
                                    <RadzenStack>
                                        <RadzenText>@(offer.Title)</RadzenText>
                                            <RadzenText>Veliko Tarnovo</RadzenText>
                                        </RadzenStack>
                                        <RadzenStack>
                                            <RadzenText>@offer.Description</RadzenText>
                                        </RadzenStack>
                                    </RadzenStack>
                                    <hr style="border: none; background-color: rgba(0,0,0,.2); height: 1px; margin: 1rem 0;" />
                                    <RadzenRow>
                                        <RadzenColumn>
                                            <RadzenBadge BadgeStyle="BadgeStyle.Secondary" Text=@($"{String.Format(new System.Globalization.CultureInfo("en-US"), "{0:C}", offer.Price)}") />
                                        </RadzenColumn>
                                    </RadzenRow>
                                </RadzenCard>
                            </a>
                        </li>
                }

                <li class="list-group-item" id="observerTarget"></li>
            </ul>
        </Sve.Blazor.InfiniteScroll.Components.InfiniteScroll>
    }
</div>

@code {
    [Parameter]
    public CarSearchRequestModel Data { get; set; }

    private List<CarOfferModel> _carOffers = new();
    private int _totalFetched = 0;
    private const int MaxOffersPerFetch = 5;

    protected override async Task OnInitializedAsync()
    {
        await FetchForecasts();
    }

    private async Task FetchForecasts()
    {
        var client = HttpClientFactory.CreateClient("OnebrbAPINoAuth");
        var response = await client.GetAsync($"/api/offers/cars?$filter=Specification/BrandId eq '{Data.BrandId}' and Specification/ModelId eq '{Data.ModelId}' &$top={MaxOffersPerFetch}&$skip={_totalFetched}");

        response.EnsureSuccessStatusCode();

        var apiResponse = await response.Content.ReadFromJsonAsync<IEnumerable<CarOfferModel>>();
        _carOffers.AddRange(apiResponse);

        _totalFetched += apiResponse.Count();
    }
}