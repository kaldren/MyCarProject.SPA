@using AutoMapper;
@using System.Net;
@using System.Text.Json;
@using System.Text;
@using Troshka.SPA.Components.Vehicle
@using Troshka.SPA.Interfaces;
@using Troshka.SPA.Models.Car;

@inject IOnebrbApiClientPublic OnebrbApiClient
@inject IMapper Mapper
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavManager

@if (Data != null)
{
    if (_carOffers != null)
    {
        <div class="Components__SearchResultInfiniteScroll">
                <Sve.Blazor.InfiniteScroll.Components.InfiniteScroll ObserverTargetId="observerTarget" ObservableTargetReached="(e) => FetchForecasts()">
                    <ul>
                        @foreach (var offer in _carOffers)
                        {
                            string uri = $"offers/{offer.Id}";

                            <li>
                                <VehicleBox Model=@offer />
                            </li>
                        }

                        <li class="list-group-item" id="observerTarget"></li>
                    </ul>
                </Sve.Blazor.InfiniteScroll.Components.InfiniteScroll>
        </div>
    }
}

@code {
    [Parameter]
    public VehicleSearchRequestModel Data { get; set; }

    private List<CarOfferModel> _carOffers = new();

    private int _totalFetched = 0;
    private const int MaxOffersPerFetch = 10;
    private bool _showNoResults;

    public void ClearSearch() => _carOffers.Clear();

    protected override async Task OnInitializedAsync()
    {
        if (Data != null)
            await FetchForecasts();
    }

    private async Task FetchForecasts()
    {
        var client = HttpClientFactory.CreateClient("OnebrbAPINoAuth");
        bool _hasFilters = Data.BrandId != null || Data.ModelId != null;
        bool _hasAppendedFilter = false;

        if (Data.Category == "Cars")
        {
            StringBuilder uriBuilder = new("/api/cars/offers");

            if (_hasFilters)
            {
                uriBuilder.Append("?$filter=");

                if (Data.BrandId != null)
                {
                    string and = _hasAppendedFilter ? " and " : string.Empty;

                    uriBuilder.Append($"{and}Specification / BrandId eq '{Data.BrandId}'");

                    _hasAppendedFilter = true;
                }

                if (Data.ModelId != null)
                {
                    string and = _hasAppendedFilter ? "and" : string.Empty;

                    uriBuilder.Append($" {and} Specification / ModelId eq '{Data.ModelId}'");

                    _hasAppendedFilter = true;
                }

                if (Data.RegionId != null)
                {
                    string and = _hasAppendedFilter ? " and " : string.Empty;

                    uriBuilder.Append($"{and}Region / Id eq '{Data.RegionId}'");

                    _hasAppendedFilter = true;
                }

                if (Data.LocationId != null)
                {
                    string and = _hasAppendedFilter ? " and " : string.Empty;

                    uriBuilder.Append($"{and}Location / Id eq '{Data.LocationId}'");

                    _hasAppendedFilter = true;
                }

                var response = await client.GetAsync($"{uriBuilder.ToString()}&$top={MaxOffersPerFetch}&$skip={_totalFetched}");

                response.EnsureSuccessStatusCode();

                var apiResponse = await response.Content.ReadFromJsonAsync<IEnumerable<CarOfferModel>>();

                if (apiResponse.Any())
                {
                    _carOffers.AddRange(apiResponse);

                    _totalFetched += apiResponse.Count();
                }
            }
        }
    }
}