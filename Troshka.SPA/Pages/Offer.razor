@page "/offers/{Id}"

@using Troshka.SPA.Components.Vehicle

<div class="Pages__Offer">
    <main>
        <Slideshow Id="@Id" />
        <OfferInformation Id="@Id" />
        <Comments Id="@Id" />
    </main>
    <aside>
        <Contact Id="@Id" />
    </aside>
</div>

@code {
    [Parameter]
    public string Id { get; set; }
}