@page "/offers/{Id}"

@using Troshka.SPA.Components.Vehicle

<div class="Pages__Vehicle">
    <main>
        <Slideshow Id="@Id" />
        <VehicleData Id="@Id" />
        <Comment Id="@Id" />
    </main>
    <aside>
        <Contact Id="@Id" />
    </aside>
</div>

@code {
    [Parameter]
    public string Id { get; set; }
}