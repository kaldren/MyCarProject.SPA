@using Microsoft.AspNetCore.Components.WebAssembly.Services;
@using System.Reflection;
@inject IStringLocalizer<Localization.ContactResource> LocalizerShared

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <Authorizing>
                    <p>@LocalizerShared["AuthenticatingPleaseWait"]</p>
                </Authorizing>
                <NotAuthorized>
                   <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>@LocalizerShared["NothingAtThisAddress"]</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <Error StatusCode="ResponseStatusCodeEnum.NotFound" Message="@LocalizerShared["NothingAtThisAddress"]" />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>